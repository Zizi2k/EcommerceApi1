<script>
    new Swiper('#swiper-1', {
        slidesPerView: 6,
        spaceBetween: 20,
        loop: true,

        autoplay: {
            delay: 3000,
        },

        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        },

        breakpoints: {
            480: {
                slidesPerView: 2
            },
            768: {
                slidesPerView: 3
            },
            1024: {
                slidesPerView: 6
            }
        }
    });
</script>